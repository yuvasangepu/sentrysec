#!/usr/bin/env python3
"""
SentrySec - Hardware Alert Bridge
======================================
Sends risk-level alerts and status text to the ESP32 advanced module
(OLED + buzzer + RGB LED) over serial, and listens for PIR motion
events during a scan.

This is optional - sentrysec.py works standalone without it. Import
and call these functions from sentrysec.py if you have the advanced
ESP32 module connected.

Requires: pip install pyserial
"""

import serial
import time


class HardwareBridge:
    def __init__(self, port, baud=115200):
        self.ser = None
        try:
            self.ser = serial.Serial(port, baud, timeout=1)
            time.sleep(2)  # allow ESP32 to reset after serial connect
            print(f"[*] Hardware bridge connected on {port}")
        except serial.SerialException as e:
            print(f"[!] Hardware bridge unavailable ({e}) - continuing without it")

    def available(self):
        return self.ser is not None

    def send_status(self, text):
        """Show a short status line on the OLED (max ~20 chars fits cleanly)."""
        if not self.available():
            return
        try:
            self.ser.write(f"STATUS:{text}\n".encode())
        except serial.SerialException:
            pass

    def send_risk_alert(self, risk_label):
        """Trigger buzzer pattern matching a risk label
        (CRITICAL/HIGH/MEDIUM/LOW/NONE)."""
        if not self.available():
            return
        try:
            self.ser.write(f"ALERT:{risk_label}\n".encode())
        except serial.SerialException:
            pass

    def poll_pir_events(self):
        """Non-blocking check for any PIR_TRIGGERED events since last poll.
        Returns a list of timestamps (ms since ESP32 boot) if motion was
        detected near the device during the scan window."""
        events = []
        if not self.available():
            return events
        try:
            while self.ser.in_waiting:
                line = self.ser.readline().decode(errors="ignore").strip()
                if line.startswith("PIR_TRIGGERED"):
                    _, ts = line.split(",")
                    events.append(ts)
        except serial.SerialException:
            pass
        return events

    def close(self):
        if self.ser:
            self.ser.close()


# ---------------------------------------------------------------------------
# Example standalone test
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    import sys
    if len(sys.argv) < 2:
        print("Usage: python hardware_alert_bridge.py <serial_port>")
        sys.exit(1)

    bridge = HardwareBridge(sys.argv[1])
    bridge.send_status("Test mode")
    for level in ["LOW", "MEDIUM", "HIGH", "CRITICAL", "NONE"]:
        print(f"Sending alert: {level}")
        bridge.send_risk_alert(level)
        time.sleep(3)
    bridge.close()
